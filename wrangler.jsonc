    // ─── AUTH ───
    // Mur d'authentification : "off" (déploiement progressif, identifie sans bloquer) → "on" (login obligatoire partout)
    "AUTH_ENFORCE": "on"
    // JWT_SECRET / BOOTSTRAP_MATRICULE / BOOTSTRAP_PIN = SECRETS Pages (JAMAIS committés) :
    //   npx wrangler pages secret put JWT_SECRET        --project-name seem-semrac-erp
    //   npx wrangler pages secret put BOOTSTRAP_MATRICULE --project-name seem-semrac-erp
    //   npx wrangler pages secret put BOOTSTRAP_PIN     --project-name seem-semrac-erp
    // En LOCAL (wrangler pages dev), mettre ces valeurs dans un fichier .dev.vars (déjà gitignored) — voir .dev.vars.example.
