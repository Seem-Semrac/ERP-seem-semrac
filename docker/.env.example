# ══════════════════════════════════════════════════════════════
# Variables de la stack Docker locale — ERP Seem Semrac
# ──────────────────────────────────────────────────────────────
#   cp .env.example .env     (une seule fois)     puis     docker compose up -d
#
# ⚠️  DEV LOCAL UNIQUEMENT. Les clés ci-dessous sont les clés de DÉMONSTRATION
#     PUBLIQUES de Supabase (connues de tous). Elles NE protègent RIEN.
#     Pour un hébergement réel (VPS/serveur), régénérer TOUT (voir docs/technique/
#     12-docker-installation.md, section « Passer en production »).
#
#     JWT_SECRET, ANON_KEY et SERVICE_ROLE_KEY forment un TRIO COHÉRENT
#     (les 2 clés sont signées avec ce JWT_SECRET). Ne changez pas l'un sans
#     régénérer les autres, sinon PostgREST/Storage rejetteront les requêtes.
# ══════════════════════════════════════════════════════════════

# ─── Postgres ───
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=erp-local-dev-postgres-pwd

# ─── Secrets Supabase (trio cohérent — clés de démo publiques) ───
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
# Clés opaques asymétriques (ES256) — non utilisées en local, laisser vide.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# ─── Passerelle Kong / URLs ───
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
SUPABASE_PUBLIC_URL=http://localhost:8000

# ─── PostgREST ───
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# ─── Storage (GED) ───
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907

# ─── Studio (dashboard http://localhost:8000) ───
STUDIO_DEFAULT_ORGANIZATION=Seem Semrac
STUDIO_DEFAULT_PROJECT=ERP
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# ══════════════════════════════════════════════════════════════
# APPLICATION ERP (conteneur "app")
# ══════════════════════════════════════════════════════════════
APP_PORT=3000
# Mur d'authentification ERP : on = login matricule+PIN obligatoire (comme en production,
# chaque salarié entre SON matricule et SON code PIN, ceux de la fiche RH) ;
# off = on circule librement — À RÉSERVER aux essais et aux captures de documentation.
# Défaut « on » depuis le 25/08/2026 : un ERP interne sans mur d'auth expose paie,
# habilitations et données clients à quiconque atteint le port.
# ⚠ Avant de passer à « on », vérifier que les salariés ont bien un matricule ET un PIN :
#   select count(*) from salaries where actif is not false and (pin is null or btrim(pin)='');
#   → doit renvoyer 0, sinon ces personnes seront verrouillées dehors.
AUTH_ENFORCE=on
# Secret de signature des SESSIONS de l'ERP (≠ JWT_SECRET Supabase ci-dessus).
# À CHANGER pour tout usage non-jetable : openssl rand -base64 48
APP_JWT_SECRET=change-me-erp-session-secret-min-32-characters-please
# Compte de secours anti-verrouillage (quand AUTH_ENFORCE=on).
BOOTSTRAP_MATRICULE=ADMIN
BOOTSTRAP_PIN=0000
