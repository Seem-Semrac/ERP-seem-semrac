  "version": "0.0.1",
  "configurations": [
    {
      "name": "ERP Dev Server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "C:\\Program Files\\nodejs\\node_modules\\npm\\bin\\npm-cli.js",
        "run",
        "preview"
      ],
      "port": 8788
